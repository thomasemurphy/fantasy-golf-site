<% bar_color = { "overall" => nil, "majors" => "#c0392b", "side_events" => "#198754", "pink_events" => "#e07ab8", "first_half" => "#F5D049", "second_half" => "#D46C19" }[tab_id] %>
<% pot_top_n  = { "overall" => 5, "majors" => 3, "side_events" => 3, "pink_events" => 1, "first_half" => 1, "second_half" => 1 }[tab_id] %>
<% pot_tint   = bar_color || "var(--color-regular)" %>
<% max_total_earnings = standings.map { |r| r[:total_earnings_cents].to_i }.max || 1 %>
<% scoped = @initial_tab == tab_id %>
<% default_sort = tab_id == "side_events" ? "proj_high_purse" : "earnings" %>
<% cur_sort = (scoped ? @sort : nil) || default_sort; cur_dir = (scoped ? @dir : nil) || "desc" %>
<% s_base = { tab: tab_id } %>
<% skip_wrapper = local_assigns.fetch(:skip_wrapper, false) %>
<% tag_open  = skip_wrapper ? "".html_safe : "<div class=\"standings-table-wrapper\">".html_safe %>
<% tag_close = skip_wrapper ? "".html_safe : "</div>".html_safe %>
<%= tag_open %>
  <table class="standings-table">
    <thead>
      <tr>
        <th>Rank</th>
        <th><%= sort_header("Player",   "player", s_base, cur_sort, cur_dir) %></th>
        <th></th>
        <th class="text-end"><%= sort_header("Earnings", "earnings", s_base, cur_sort, cur_dir, natural_dir: "desc") %></th>
        <% if tab_id == "side_events" %>
          <th>FedEx Pick</th>
          <th class="text-end">Proj. FedEx $</th>
          <th class="text-end"><%= sort_header("Proj High-Purse", "proj_high_purse", s_base, cur_sort, cur_dir, natural_dir: "desc") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% standings.each do |row| %>
        <% money_rank = tab_id == "side_events" ? row[:proj_high_purse_rank] : row[:rank].to_s.sub("T", "").to_i %>
        <% in_money = pot_top_n && money_rank && money_rank.positive? && money_rank <= pot_top_n %>
        <tr class="<%= 'highlight' if row[:user] == current_user %>"<%= " style=\"background: color-mix(in srgb, #{pot_tint} 18%, transparent)\"".html_safe if in_money %>>
          <td><span class="standings-rank"><%= row[:rank] %></span></td>
          <td>
            <%= render "standings/player_tooltip", row: row, pool_max_total: max_total_earnings,
                       pool_size: standings.size, rank: row[:rank], live_pick: row[:live_pick] %>
          </td>
          <td><%= "💰" * (pot_top_n - money_rank + 1) if in_money %></td>
          <td class="text-end tabular-nums">
            <% if row[:earnings_cents] %>
              $<%= number_with_delimiter((row[:earnings_cents] / 100.0).to_i) %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <% if tab_id == "side_events" %>
            <td>
              <% if row[:fedex_golfer] %>
                <%= row[:fedex_golfer].name %>
                <% if row[:fedex_pick].is_double_down? %><span class="badge bg-warning text-dark ms-1">2x</span><% end %>
                <% if row[:fedex_pick].auto_assigned? %><span class="badge bg-secondary ms-1">Auto</span><% end %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td class="text-end tabular-nums">
              <% if row[:fedex_projected_cents] %>
                $<%= number_with_delimiter((row[:fedex_projected_cents] / 100.0).to_i) %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td class="text-end tabular-nums fw-semibold">
              $<%= number_with_delimiter((row[:side_plus_fedex_cents].to_i / 100.0).to_i) %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<%= tag_close %>
